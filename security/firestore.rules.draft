// DRAFT ONLY — not deployed. Validate with Firestore Emulator before applying.
// Requires verified email for joining by invitation; legacy @family.local logins
// must be migrated to real, verified email accounts before activation.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function verifiedEmail() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }
    function ownEmail(email) {
      return verifiedEmail() && request.auth.token.email.lower() == email;
    }
    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }
    function invitePath(email) {
      return /databases/$(database)/documents/invitations/$(email);
    }
    function memberOf(familyId) {
      return signedIn() && exists(familyPath(familyId)) &&
        get(familyPath(familyId)).data.members is list &&
        request.auth.uid in get(familyPath(familyId)).data.members;
    }
    function ownerOf(familyId) {
      return signedIn() && exists(familyPath(familyId)) &&
        get(familyPath(familyId)).data.ownerId == request.auth.uid;
    }
    function ownerAfter(familyId) {
      return signedIn() && getAfter(familyPath(familyId)).data.ownerId == request.auth.uid;
    }
    function invitedTo(familyId) {
      return verifiedEmail() &&
        exists(invitePath(request.auth.token.email.lower())) &&
        get(invitePath(request.auth.token.email.lower())).data.familyId == familyId;
    }
    function canJoin(familyId) {
      return invitedTo(familyId) &&
        !(request.auth.uid in resource.data.members) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.auth.uid in request.resource.data.members;
    }

    match /users/{userId} {
      allow get, create, update: if signedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }

    match /families/{familyId} {
      // An invitee may read just the family document needed for joining.
      allow get: if memberOf(familyId) || invitedTo(familyId);
      allow list: if false;
      allow create: if signedIn() &&
        familyId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members == [request.auth.uid];
      // The owner can manage family metadata. An invitee can add only their own UID
      // when a verified email invitation exists. This must be tested with join transaction.
      allow update: if (ownerOf(familyId) &&
        request.resource.data.ownerId == resource.data.ownerId) ||
        canJoin(familyId);
      allow delete: if false;

      match /members/{memberId} {
        allow get: if memberOf(familyId) ||
          (invitedTo(familyId) &&
           get(invitePath(request.auth.token.email.lower())).data.placeholderMemberId == memberId);
        allow list: if memberOf(familyId);
        allow create: if ownerAfter(familyId) &&
          (request.resource.data.userId == null ||
           request.resource.data.userId == request.auth.uid);
        allow update: if (
          memberOf(familyId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'color', 'avatar', 'email', 'userId']) &&
          request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
          // Members may not claim or release someone else's linked identity.
          (
            request.resource.data.get('userId', null) == resource.data.get('userId', null) ||
            (resource.data.get('userId', null) in [null, request.auth.uid] &&
             request.resource.data.get('userId', null) in [null, request.auth.uid] &&
             (
               request.resource.data.get('userId', null) == null ||
               (resource.data.get('email', '') == '' ||
                ownEmail(resource.data.get('email', '')))
             ))
          )
        ) || (
          // Invited user claims only the exact placeholder in the join transaction.
          invitedTo(familyId) &&
          get(invitePath(request.auth.token.email.lower())).data.placeholderMemberId == memberId &&
          resource.data.get('userId', null) == null &&
          request.resource.data.get('userId', null) == request.auth.uid &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userId', 'avatar', 'isAdmin']) &&
          request.auth.uid in getAfter(familyPath(familyId)).data.members
        );
        allow delete: if ownerOf(familyId) &&
          resource.data.get('userId', null) == null &&
          resource.data.get('isAdmin', false) == false;

        match /config/{configId} {
          allow read, write: if memberOf(familyId) && memberId == request.auth.uid;
        }
      }

      match /config/{configId} {
        allow read, write: if memberOf(familyId) || ownerAfter(familyId);
      }

      // Explicit allowlist prevents the members/config paths above from being
      // accidentally reopened by a permissive recursive wildcard.
      match /{collectionName}/{docId} {
        allow read, write: if memberOf(familyId) &&
          collectionName in [
            'transactions', 'shopping', 'pantry', 'events', 'goals',
            'categories', 'rules', 'knowledge', 'debts', 'projects',
            'loyalty', 'wishlist', 'accounts', 'subscriptions',
            'notifications', 'mandatoryExpenses'
          ];
      }
    }

    match /invitations/{email} {
      // Only the invitee can read their invitation; the owner may read
      // invitations for their own family, not list all email addresses.
      allow get: if ownEmail(email) ||
        (signedIn() && resource != null && ownerOf(resource.data.familyId));
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.email == email &&
        ownerOf(request.resource.data.familyId) &&
        getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(request.resource.data.placeholderMemberId)).data.email == email;
      allow update: if false;
      // Invitee can consume their invitation only when the same transaction
      // added them to the exact family. Owner may cancel a pending invitation.
      allow delete: if ownerOf(resource.data.familyId) ||
        (ownEmail(email) &&
         request.auth.uid in getAfter(familyPath(resource.data.familyId)).data.members);
    }

    match /global_rules/{ruleId} {
      allow read: if signedIn();
      allow write: if false; // Shared writable rules can poison all families.
    }

    match /system_logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
