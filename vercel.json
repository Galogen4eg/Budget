{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/calendar-telegram-run.js": {
      "maxDuration": 30,
      "memory": 1024,
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "schedules": {
    "calendar-telegram-every-10m": {
      "schedule": "*/10 * * * *",
      "function": "api/calendar-telegram-run.js",
      "timezone": "Etc/UTC"
    }
  }
}
